# ═══════════════════════════════════════════════════════════
# OneCard Catalogue Management Platform - .gitignore
# ═══════════════════════════════════════════════════════════

# Ignore EVERYTHING by default
*

# Allow Git files
!.gitignore

# Ignore SQLite Database
onecard.db

# Allow core documentation & packages
!README.md
!API_GUIDE.md
!requirements.txt

# Allow legacy CMS v2 files
!catalogue_engine.py
!catalogue_dashboard.html
!catalogue_data.json
!Organized_Catalogue_Master.xlsx

# Allow new Flask application files
!app.py
!models.py
!auth.py
!seed_products.py
!Start OneCard.bat

# Allow static files and templates directories
!static/
!static/**
!templates/
!templates/**

# Allow the end-to-end test suite (handover to the technical team)
!tests/
!tests/**

# Allow design/spec docs
!docs/
!docs/**

# Never commit local secrets, backups or uploaded files (all already
# excluded by the default-deny above; listed here for clarity)
instance_secret.key
instance_encryption.key
backups/
uploads/
